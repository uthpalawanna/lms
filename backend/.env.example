# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file — it's in .gitignore for a reason.

MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<db-name>
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
PORT=5000

# PayHere payment gateway (sandbox credentials from your PayHere merchant dashboard)
PAYHERE_MERCHANT_ID=your_payhere_merchant_id
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret
PAYHERE_MODE=sandbox

# Public URLs — used to build PayHere return/notify URLs and CORS/CSP allowlists
APP_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Resend (used for password-reset emails) — https://resend.com, free tier
# RESEND_FROM is optional; defaults to Resend's shared onboarding@resend.dev
# sender, which needs no domain verification but can only send to the
# email address your Resend account itself is registered under. Verify
# your own domain in the Resend dashboard to send to any address.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=SHRI LMS <onboarding@resend.dev>

# Google OAuth ("Sign in with Google") — must match the Client ID used
# in the frontend's VITE_GOOGLE_CLIENT_ID (same value, this is the
# audience the backend verifies incoming tokens against)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com